# RedTeam Court reads no signing key from the environment: keys live in
# .data/ (gitignored), created by scripts/deploy_studionet.py (deployer) and
# scripts/generate_fixtures.py (demo wallets). The optional settings below are
# read only when set; leave them empty in this file.

# 1 = let tests/integration send writes to the canonical deployment.
REDTEAM_LIVE_WRITES=
# GenVM runner bundle release for scripts/fetch_genvm_bundle.py.
GENVM_VERSION=
